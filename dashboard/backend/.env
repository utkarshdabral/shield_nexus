# Backend Environment Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/analytics.db

# Python paths (relative to backend root)
PYTHON_SCRIPTS_PATH=./python
DOT404_PATH=../../DOT404
SENTI_PATH=../../senti

# Risk fusion defaults
RISK_WEIGHT_CCTV=0.6
RISK_WEIGHT_SENTIMENT=0.4

# Logging
LOG_LEVEL=info
